{
  "name": "ingest-classifier",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "run": "tsx src/cli.ts run",
    "watch": "tsx src/cli.ts watch",
    "mcp": "tsx src/mcp/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:fixed-taxonomy": "tsx evals/fixed-taxonomy.ts",
    "eval:adaptive-taxonomy": "tsx evals/adaptive-taxonomy.ts",
    "eval:retrieval-and-clustering": "tsx evals/retrieval-and-clustering.ts",
    "eval:mcp-worker": "tsx evals/mcp-worker.ts",
    "backfill": "tsx src/cli.ts backfill",
    "correct": "tsx src/cli.ts correct",
    "cluster": "tsx src/cli.ts cluster",
    "ask": "tsx src/cli.ts ask",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write --error-on-warnings .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.2",
    "openai": "^7.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.9.0"
}
