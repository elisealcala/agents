# Copy to .env and fill the key for the provider you pick.
# All three of INGEST_PROVIDER, INGEST_MODEL, and the matching API key are required.

# Recommended fast M1 pairing; both values remain explicit and replaceable.
INGEST_PROVIDER=openai
INGEST_MODEL=gpt-4o-mini

# INGEST_PROVIDER=anthropic
# INGEST_MODEL=claude-sonnet-4-20250514

# INGEST_PROVIDER=xai
# INGEST_MODEL=grok-4

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Optional. New category proposals above this semantic similarity merge into the nearest category.
INGEST_CATEGORY_DEDUP_THRESHOLD=0.85
